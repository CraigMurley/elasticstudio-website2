{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npx --yes puppeteer browsers install chrome",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
